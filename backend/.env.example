# Copy this file to backend/.env and fill in real values.
# Do NOT commit backend/.env.

# Required for Gemini synthesis/captioning
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override
GEMINI_MODEL_ID=gemini-2.5-flash

# CORS for frontend deployments (comma-separated)
# Example: https://your-frontend.com,https://staging.your-frontend.com
CORS_ALLOWED_ORIGINS=*
